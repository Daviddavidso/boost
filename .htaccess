# ————— BOOST —————
# Закрываем служебные файлы: пароль от панели и токены сессий
# не должны открываться по прямой ссылке.

<FilesMatch "^(config\.php|config\.sample\.php|\.tokens|data\.backup\.js|README\.md)$">
  Require all denied
</FilesMatch>

# Индексный файл
DirectoryIndex index.html

# Кэш статики: картинки и шрифты держим долго, разметку и данные — нет,
# иначе клиент правит каталог в панели, а посетитель видит старый.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"
  ExpiresByType image/svg+xml           "access plus 30 days"
  ExpiresByType font/woff2              "access plus 30 days"
</IfModule>

<FilesMatch "^(index\.html|admin\.html|data\.js)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
