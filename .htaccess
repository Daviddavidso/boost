# ————— BOOST —————
# Закрываем служебные файлы: пароль от панели и токены сессий
# не должны открываться по прямой ссылке.

<FilesMatch "^(config\.php|config\.sample\.php|\.tokens|data\.backup\.js|README\.md)$">
  Require all denied
</FilesMatch>

# Индексный файл
DirectoryIndex index.html

# Кэш статики: картинки и шрифты держим долго, разметку и данные — нет,
# иначе клиент правит каталог в панели, а посетитель видит старый.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"
  ExpiresByType image/svg+xml           "access plus 30 days"
  ExpiresByType font/woff2              "access plus 30 days"
</IfModule>

<FilesMatch "^(index\.html|admin\.html|data\.js)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# data.php отдаёт каталог сам и ставит свои заголовки кеша: браузер обязан
# каждый раз спрашивать сервер, не менялся ли каталог. Без этой врезки
# mod_expires добавляет к нему второй Cache-Control (по типу javascript,
# на неделю вперёд), и заголовки начинают спорить между собой.
<FilesMatch "^(data|check)\.php$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header unset Expires
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>
